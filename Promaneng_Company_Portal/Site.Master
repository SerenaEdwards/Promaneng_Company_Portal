<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Promaneng_Company_Portal.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Promaneng Internal Portal</title>

    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    
    <!-- Custom Project Stylesheet -->
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid p-0">
            <div class="row g-0">
                
                <!-- SIDEBAR MODULE NAVIGATION -->
                <nav class="col-md-3 col-lg-2 sidebar p-3 d-flex flex-column justify-content-between">
                    <div>
                        <!-- BRAND LOGO HEADER -->
                        <div class="d-flex align-items-center mb-4 ps-2">
                            <i class="bi bi-building-gear text-warning fs-2 me-2"></i>
                            <span class="fs-4 fw-bold text-white tracking-wide">PROMANENG</span>
                        </div>

                        <!-- NAVIGATION LINKS -->
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" href="Default.aspx">
                                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Client.aspx">
                                    <i class="bi bi-people me-2"></i> Clients
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Projects.aspx">
                                    <i class="bi bi-diagram-3 me-2"></i> Projects
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Employees.aspx">
                                    <i class="bi bi-person-badge me-2"></i> Employees
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Assignments.aspx">
                                    <i class="bi bi-list-check me-2"></i> Resource Assignments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Equipment.aspx">
                                    <i class="bi bi-truck me-2"></i> Equipment Fleet
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Maintenance.aspx">
                                    <i class="bi bi-tools me-2"></i> Vendor & Maintenance
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- SIDEBAR FOOTER -->
                    <div class="ps-2 sidebar-footer">
                        <div>Internal Network Only</div>
                        <div>Promaneng Co. Ltd &copy; 2026</div>
                    </div>
                </nav>

                <!-- MAIN CONTENT WRAPPER -->
                <main class="col-md-9 col-lg-10 ms-sm-auto">
                    
                    <!-- TOP NAVBAR HEADER-->
                    <header class="top-navbar d-flex justify-content-between align-items-center shadow-sm">
                        <!-- PAGE TITLE -->
                        <h1 class="page-title"><%: Page.Title %></h1>

                        <!-- LOGGED IN USER SECTION & LOGOUT -->
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-bell-fill text-white fs-5 me-1"></i>
                            <div class="user-info-text">
                                Logged in as: <strong><asp:Label ID="lblUserDetails" runat="server" Text="Developer Admin (Site Manager)"></asp:Label></strong>
                            </div>
                            <asp:LinkButton ID="btnLinkLogout" runat="server" CssClass="btn btn-logout-orange" OnClick="btnLogout_Click" CausesValidation="false">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </asp:LinkButton>
                        </div>
                    </header>

                    <!-- CHILD PAGE CONTENT PLACEHOLDER -->
                    <div class="p-4">
                        <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>

                </main>
            </div>
        </div>
    </form>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>